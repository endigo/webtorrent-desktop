{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebTorrent",
  "version": "0.25.0",
  "identifier": "io.webtorrent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WebTorrent",
        "width": 1024,
        "height": 768,
        "minWidth": 425,
        "minHeight": 138
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
