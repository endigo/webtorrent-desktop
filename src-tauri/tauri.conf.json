{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebTorrent",
  "version": "0.25.0",
  "identifier": "io.webtorrent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WebTorrent",
        "width": 500,
        "height": 638,
        "minWidth": 425,
        "minHeight": 238,
        "visible": false,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magnet"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "The streaming torrent client.",
    "longDescription": "WebTorrent Desktop is a streaming torrent client for macOS, Windows and Linux.",
    "copyright": "Copyright © 2014-2026 WebTorrent, LLC",
    "publisher": "WebTorrent, LLC",
    "homepage": "https://webtorrent.io",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "BitTorrent Document",
        "description": "BitTorrent Document",
        "mimeType": "application/x-bittorrent",
        "role": "Editor"
      }
    ]
  }
}
